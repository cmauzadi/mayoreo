{%- if section.blocks.size > 0 -%}
  <section class="section"{% if section.settings.sin_margen_superior %} style="padding-top:0"{% endif %}>
    <div class="wrap">
      <div class="svcs reveal">
        {%- for block in section.blocks -%}
          <div class="svc" {{ block.shopify_attributes }}>
            {%- render 'icono', nombre: block.settings.icono -%}
            <b>{{ block.settings.titulo }}</b>
            <p>{{ block.settings.texto }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Servicios",
  "max_blocks": 4,
  "settings": [
    { "type": "checkbox", "id": "sin_margen_superior", "label": "Pegar a la sección de arriba", "default": true }
  ],
  "blocks": [
    {
      "type": "servicio",
      "name": "Servicio",
      "settings": [
        {
          "type": "select",
          "id": "icono",
          "label": "Ícono",
          "options": [
            { "value": "envio", "label": "Camión de envío" },
            { "value": "caja", "label": "Caja" },
            { "value": "garantia", "label": "Escudo" },
            { "value": "pago", "label": "Tarjeta" },
            { "value": "tienda", "label": "Tienda" },
            { "value": "reloj", "label": "Reloj" }
          ],
          "default": "envio"
        },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Envío a todo México" },
        { "type": "textarea", "id": "texto", "label": "Texto", "default": "24 a 72 horas en zonas metropolitanas." }
      ]
    }
  ],
  "presets": [{ "name": "Servicios" }],
  "default": {
    "blocks": [
      { "type": "servicio", "settings": { "icono": "envio", "titulo": "Envío a todo México", "texto": "24 a 72 horas en zonas metropolitanas. Gratis desde $1,499 en menudeo y desde 12 pares en mayoreo." } },
      { "type": "servicio", "settings": { "icono": "caja", "titulo": "Corrida completa", "texto": "Caja de 12 pares con tallas 25 a 30 MX. También armamos surtidos según lo que más te rote." } },
      { "type": "servicio", "settings": { "icono": "garantia", "titulo": "Cambios sin pelear", "texto": "30 días para cambiar talla en menudeo. En mayoreo reponemos cualquier par con defecto de fábrica." } },
      { "type": "servicio", "settings": { "icono": "pago", "titulo": "Pagas como quieras", "texto": "Tarjeta, 12 MSI, OXXO, transferencia SPEI y Mercado Pago. Facturamos CFDI 4.0 el mismo día." } }
    ]
  }
}
{% endschema %}

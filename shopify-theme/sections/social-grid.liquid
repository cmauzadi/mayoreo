{%- if section.blocks.size > 0 -%}
  <section class="section"{% if section.settings.sin_margen_superior %} style="padding-top:0"{% endif %}>
    <div class="wrap">
      <div class="sec-head reveal">
        <div>
          {%- if section.settings.handle != blank -%}<span class="mono eyebrow">{{ section.settings.handle }}</span>{%- endif -%}
          <h2 class="disp">{{ section.settings.titulo }}</h2>
        </div>
        {%- if settings.social_instagram != blank -%}
          <a class="btn btn-ghost btn-sm" href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Seguir en Instagram</a>
        {%- endif -%}
      </div>
      <div class="social-grid reveal">
        {%- for block in section.blocks -%}
          {%- assign num = forloop.index | plus: 8 | prepend: '0' | slice: -2, 2 -%}
          <a href="{{ block.settings.url | default: settings.social_instagram | default: '#' }}"
             {% if block.settings.url != blank %}target="_blank" rel="noopener"{% endif %}
             aria-label="Publicación {{ forloop.index }}" {{ block.shopify_attributes }}>
            {%- render 'slate', image: block.settings.imagen, ratio: '1/1', num: num, label: '1:1' -%}
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Instagram",
  "max_blocks": 12,
  "settings": [
    { "type": "checkbox", "id": "sin_margen_superior", "label": "Pegar a la sección de arriba", "default": true },
    { "type": "text", "id": "handle", "label": "Usuario", "default": "@tutienda" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "En la calle" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Publicación",
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Imagen" },
        { "type": "url", "id": "url", "label": "Enlace" }
      ]
    }
  ],
  "presets": [{ "name": "Instagram" }],
  "default": {
    "blocks": [
      { "type": "post" }, { "type": "post" }, { "type": "post" },
      { "type": "post" }, { "type": "post" }, { "type": "post" }
    ]
  }
}
{% endschema %}

<div class="wrap page page-narrow">
  <span class="mono eyebrow">Mi cuenta</span>
  <h1 class="disp">Iniciar sesión</h1>
  {%- form 'customer_login' -%}
    {%- if form.errors -%}<div class="form-error mono" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="stack">
      <div class="field"><label class="mono" for="l-mail">Correo</label><input class="select" id="l-mail" name="customer[email]" type="email" autocomplete="email" required></div>
      <div class="field"><label class="mono" for="l-pass">Contraseña</label><input class="select" id="l-pass" name="customer[password]" type="password" autocomplete="current-password" required></div>
      <button class="btn" type="submit">Entrar</button>
      <a class="mono faint" href="{{ routes.account_register_url }}">Crear una cuenta</a>
    </div>
  {%- endform -%}
</div>

<div class="wrap page page-narrow">
  <span class="mono eyebrow">Mi cuenta</span>
  <h1 class="disp">Nueva contraseña</h1>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}<div class="form-error mono" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="stack">
      <div class="field"><label class="mono" for="rp-1">Contraseña</label><input class="select" id="rp-1" name="customer[password]" type="password" autocomplete="new-password" required></div>
      <div class="field"><label class="mono" for="rp-2">Confirmar contraseña</label><input class="select" id="rp-2" name="customer[password_confirmation]" type="password" autocomplete="new-password" required></div>
      <button class="btn" type="submit">Guardar</button>
    </div>
  {%- endform -%}
</div>

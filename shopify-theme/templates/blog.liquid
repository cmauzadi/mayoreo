<div class="wrap page">
  <span class="mono eyebrow">Blog</span>
  <h1 class="disp">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="grid" style="--cols:3;margin-top:32px">
      {%- for article in blog.articles -%}
        <a class="card" href="{{ article.url }}">
          <div class="card-media">
            {%- render 'slate', image: article.image, ratio: '4/5', num: forloop.index, label: 'Foto del artículo', alt: article.title -%}
          </div>
          <div class="card-body">
            <div class="card-sku mono"><span>{{ article.published_at | date: '%d.%m.%Y' }}</span></div>
            <h2 class="card-name">{{ article.title }}</h2>
            <p class="card-color">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p>
          </div>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="mono" style="display:flex;gap:16px;justify-content:center;margin-top:48px" aria-label="Paginación">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr; Anterior</a>{%- endif -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Siguiente &rarr;</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>
